  const action=ACTIONS[frame.actionKey];
  const branchClass=action.fsm.kind==='clarify'?'clarify':action.fsm.kind==='relax'?'relax':'';
  return `<section class="workspace"><div class="zone conversation"><div class="zone-head"><h3>Conversation</h3><span class="badge">${action.session} · T${action.turn}</span></div>${conversation(frame,action)}</div><div class="zone architecture"><div class="zone-head"><h3>Architecture trace</h3><span class="badge">${esc(frame.phase)}</span></div>${architecture(frame,action)}</div><div class="zone inspector"><div class="zone-head"><h3>Phase inspector</h3><span class="badge">${phaseOrder.indexOf(frame.phase)+1} / 5</span></div>${inspector(frame,action)}</div><div class="fsm-lane"><div class="fsm-box"><strong>Previous</strong><span>${esc(action.fsm.previous)}</span></div><span class="fsm-arrow">→</span><div class="fsm-box"><strong>Event / guard</strong><span>${esc(action.fsm.event)} · ${esc(action.fsm.guard)}</span></div><span class="fsm-arrow">→</span><div class="fsm-box"><strong>Next</strong><span>${esc(action.fsm.next)}</span></div><div class="fsm-box fsm-branch ${branchClass}"><strong>Branch reason</strong><span>${esc(action.fsm.branch)}</span></div></div></section>`;
}

function render(){
  const frame=frames[frameIndex];
  byId('stage').innerHTML=frame.view==='opening'?opening(frame):frame.view==='flow'?flow(frame):frame.view==='evidence'?staticEvidence(frame):frame.view==='value'?value(frame):demo(frame);
  byId('frameMeta').textContent=`${frame.id} · ${timeLabel(frame.start)}-${timeLabel(frame.end)} · ${frame.segmentLabel} · ${frame.phase}`;
  byId('narration').textContent=frame.narration;
  byId('prevFrame').disabled=frameIndex===0;
  byId('nextFrame').disabled=frameIndex===frames.length-1;
  byId('prevSegment').disabled=segments.indexOf(frame.segment)===0;
  byId('nextSegment').disabled=segments.indexOf(frame.segment)===segments.length-1;
  document.querySelectorAll('#segments button').forEach(button=>button.classList.toggle('active',button.dataset.segment===frame.segment));
}

function go(index){stopAuto();frameIndex=Math.max(0,Math.min(frames.length-1,index));render()}
function segmentStart(segment){return frames.findIndex(frame=>frame.segment===segment)}
function segmentEnd(segment){let found=-1;frames.forEach((frame,i)=>{if(frame.segment===segment)found=i});return found}
function moveSegment(delta){const current=segments.indexOf(frames[frameIndex].segment);go(segmentStart(segments[Math.max(0,Math.min(segments.length-1,current+delta))]))}
function stopAuto(){if(autoTimer){clearTimeout(autoTimer);autoTimer=null;byId('autoplay').textContent='▶'}}
function autoplay(){if(autoTimer){stopAuto();return}byId('autoplay').textContent='■';const advance=()=>{if(frameIndex>=frames.length-1){stopAuto();return}const duration=(frames[frameIndex].end-frames[frameIndex].start)*1000;autoTimer=setTimeout(()=>{frameIndex++;render();advance()},duration)};advance()}
async function toggleFull(){document.body.classList.toggle('clean-mode');if(document.body.classList.contains('clean-mode')&&!document.fullscreenElement)await document.documentElement.requestFullscreen();else if(!document.body.classList.contains('clean-mode')&&document.fullscreenElement)await document.exitFullscreen()}

byId('segments').innerHTML=segments.map(segment=>{const first=frames.find(frame=>frame.segment===segment);return `<button data-segment="${segment}" title="${first.segmentLabel}">${segment}</button>`}).join('');
byId('segments').onclick=event=>{if(event.target.dataset.segment)go(segmentStart(event.target.dataset.segment))};
byId('prevFrame').onclick=()=>go(frameIndex-1);byId('nextFrame').onclick=()=>go(frameIndex+1);
byId('prevSegment').onclick=()=>moveSegment(-1);byId('nextSegment').onclick=()=>moveSegment(1);
byId('reset').onclick=()=>go(segmentStart(frames[frameIndex].segment));byId('backup').onclick=()=>go(segmentEnd(frames[frameIndex].segment));
byId('autoplay').onclick=autoplay;byId('full').onclick=toggleFull;
document.addEventListener('fullscreenchange',()=>{if(!document.fullscreenElement)document.body.classList.remove('clean-mode')});
document.addEventListener('keydown',event=>{if(event.code==='Space'){event.preventDefault();go(frameIndex+1)}else if(event.key==='Backspace'){event.preventDefault();go(frameIndex-1)}else if(event.key==='[')moveSegment(-1);else if(event.key===']')moveSegment(1);else if(event.key.toLowerCase()==='r')go(segmentStart(frames[frameIndex].segment));else if(event.key.toLowerCase()==='b')go(segmentEnd(frames[frameIndex].segment));else if(event.key.toLowerCase()==='p')autoplay();else if(event.key.toLowerCase()==='f')toggleFull()});

const requested=new URLSearchParams(location.search).get('frame');
if(requested){const found=frames.findIndex(frame=>frame.id===requested);if(found>=0){frameIndex=found;document.body.classList.add('asset-mode')}else document.body.innerHTML=`<main style="padding:40px;font-family:system-ui"><h1>Unknown frame</h1><p>${esc(requested)}</p></main>`}
render();
</script>
</body>
</html>
