function inspector(frame,action){
  const phase=frame.phase;
  if(phase==='Message')return `<h3 class="inspector-title">Message received</h3><div class="info"><div class="info-label">Raw input</div><div class="info-value">“${esc(action.user)}”</div></div><div class="info"><div class="info-label">Session / turn</div><div class="info-value">${action.session} · ${action.turn} / 10</div></div><div class="info"><div class="info-label">State write</div><div class="info-value">Pending after understanding</div></div><div class="info"><div class="info-label">Agent response</div><div class="info-value">Hidden until phase 5</div></div>`;
