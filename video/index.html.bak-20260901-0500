}

function architecture(frame,action){
  const phase=frame.phase;
  const phaseIndex=phaseOrder.indexOf(phase);
  const baseStatus=i=>{
    if(phaseIndex===0)return i===0?'active':'pending';
    if(phaseIndex===1)return i<2?'done':i===2?'active':'pending';
    if(phaseIndex===2)return i<3?'done':i===3?'active':'pending';
