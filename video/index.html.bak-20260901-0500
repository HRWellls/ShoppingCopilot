  if(phase==='FSM / Execution')return `<h3 class="inspector-title">${esc(action.execution.route)} execution</h3><div class="info"><div class="info-label">Hard filters</div><div class="info-value">${action.execution.hardFilters.length?action.execution.hardFilters.map(esc).join('<br>'):'None · context and soft ranking remain active'}</div></div><div class="info"><div class="info-label">Ranking signals</div><div class="info-value">${action.execution.signals.map(esc).join(' · ')}</div></div><div class="ops">${action.execution.operations.map((op,i)=>`<div class="op"><span class="n">${i+1}</span><span>${esc(op)}</span></div>`).join('')}</div><div class="info"><div class="info-label">Verification / policy</div><div class="info-value"><b>${esc(action.execution.verification)}</b><br>${esc(action.execution.policy)}</div></div>`;
  const kind=action.fsm.kind==='clarify'?'clarify':action.fsm.kind==='relax'?'boundary':'';
