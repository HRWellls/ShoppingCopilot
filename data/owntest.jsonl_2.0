:", "Limited Lifetime Warranty", ": Complimentary repair service on manufacturing defects.", "Satisfaction Guaranteed", ": 30 Day return policy for all unworn items.", "Best in Class Customer Service", ": Business hours from 7am PT to 8pm PT every day, you can expect a response within 2 hours of emailing us. Outside of business hours, we will return your message within 8 hours."], "price": null, "categories": ["Clothing, Shoes & Jewelry", "Boys"], "details": {"Is Discontinued By Manufacturer": "No", "Item model number": "IG-01-200-2387", "Department": "Boys", "Date First Available": "October 30, 2017", "Manufacturer": "Ioka"}, "average_rating": 3.9, "rating_number": 8, "store": "Ioka"}
